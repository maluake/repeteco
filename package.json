{
  "name": "repeteco",
  "private": true,
  "description": "Repeteco — brechós de São Paulo. Site estático + Supabase; não há etapa de build.",
  "scripts": {
    "serve": "python3 -m http.server 8090 --bind 127.0.0.1",
    "test:e2e": "node tests/e2e/run.js",
    "test:db": "./supabase/tests/run.sh",
    "html": "node scripts/otimizar-html.js",
    "test:html": "node scripts/otimizar-html.js --check",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run lint && npm run test:html && npm run test:migracoes && npm run test:api && npm run test:e2e",
    "migracoes": "node scripts/gerar-migracoes.js",
    "test:migracoes": "node scripts/gerar-migracoes.js --check",
    "test:api": "node --test tests/api/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "axe-core": "^4.10.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "playwright": "^1.56.0"
  },
  "engines": {
    "node": ">=20"
  }
}
